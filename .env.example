# WAYCON local configuration template. Copy to .env and keep credentials local.
# Camera URIs are entered at runtime through the frontend/API; never commit them.

FACE_ENGINE_HOST=0.0.0.0
FACE_ENGINE_PORT=5010
FACE_ENGINE_URL=http://localhost:5010
FACE_ENGINE_TIMEOUT=30
FACE_ENGINE_DEVICE=auto
PERSON_CREATION_DEVICE=auto

FORENSICS_MEMORY_DB=forensics/global_memory.db
PERSON_CREATION_MEDIA_ROOT=forensics/person_db

PERSON_CREATION_ASYNC_VLM=1
PERSON_CREATION_VLM_TIMEOUT_SECONDS=60
PERSON_CREATION_VLM_MAX_RETRIES=1
PERSON_CREATION_LIVE_OVERLAP=1
PERSON_CREATION_LIVE_ROLLING_ANALYSIS=1
PERSON_CREATION_LIVE_PROCESS_EVERY_N_FRAMES=3
# Optional low-latency development setting; unset preserves the requested window.
# PERSON_CREATION_LIVE_CHUNK_SECONDS=2.0

PERSON_CREATION_IDENTITY_MIN_SIMILARITY=0.68
PERSON_CREATION_IDENTITY_MAX_SIMILARITY=0.78
PERSON_CREATION_IDENTITY_MIN_MARGIN=0.03
PERSON_CREATION_IDENTITY_MIN_FACE_OBSERVATIONS=3
