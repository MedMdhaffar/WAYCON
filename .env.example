# Copy to .env (docker-compose reads this automatically) and/or export these
# directly in your shell -- forensics/global_memory/config.py reads the same names.

GLOBAL_MEMORY_HOST=localhost
GLOBAL_MEMORY_PORT=5432
GLOBAL_MEMORY_DB=waycon_forensics
GLOBAL_MEMORY_USER=waycon
GLOBAL_MEMORY_PASSWORD=waycon

# Optional: overrides host/port/db/user/password above entirely if set.
# GLOBAL_MEMORY_DSN=postgresql://waycon:waycon@localhost:5432/waycon_forensics

GLOBAL_MEMORY_POOL_MIN_SIZE=1
GLOBAL_MEMORY_POOL_MAX_SIZE=10

FACE_SIMILARITY_THRESHOLD=0.60
CLOTHING_PIPELINE_VERSION=clothing_v1

#pgadmin service :
PGADMIN_EMAIL=admin@waycon.local
PGADMIN_PASSWORD=replace-with-a-strong-pgadmin-password
PGADMIN_PORT=5050